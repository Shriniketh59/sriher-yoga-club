# Optional: URL that accepts POSTed JSON from the "Join the Club" form.
# Leave unset until a real endpoint (Google Apps Script, Formspree, an API route
# with a database, etc.) exists. Without it the form validates but does not submit.
NEXT_PUBLIC_JOIN_ENDPOINT=

# Production URL (no trailing slash). Drives canonical links, Open Graph, sitemap
# and structured data. On Vercel the production domain is used automatically if unset.
NEXT_PUBLIC_SITE_URL=

# Search Console / Bing Webmaster verification codes (content value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Set to "true" on staging to block indexing (Vercel previews are blocked automatically)
NEXT_PUBLIC_NOINDEX=
